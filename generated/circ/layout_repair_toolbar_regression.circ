<project source="logisim-evolution">
  <lib desc="#Base" name="0"/>
  <lib desc="#Wiring" name="1"/>
  <lib desc="#Gates" name="2"/>
  <lib desc="#Plexers" name="3"/>
  <lib desc="#Arithmetic" name="4"/>
  <lib desc="#FPArithmetic" name="5"/>
  <lib desc="#Memory" name="6"/>
  <lib desc="#I/O" name="7"/>
  <lib desc="#TTL" name="8"/>
  <lib desc="#HDL-IP" name="9"/>
  <lib desc="#TCL" name="10"/>
  <lib desc="#BFH-Praktika" name="11"/>
  <lib desc="#Input/Output-Extra" name="12"/>
  <lib desc="#Soc" name="13"/>

  <main name="main"/>
  <toolbar>
    <tool lib="0" name="Poke Tool"/>
    <tool lib="0" name="Edit Tool"/>
    <tool lib="0" name="Text Tool"/>
    <sep/>
    <tool lib="1" name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
    <tool lib="1" name="Tunnel"/>
    <sep/>
    <tool lib="2" name="NOT Gate"/>
    <tool lib="2" name="AND Gate"/>
    <tool lib="2" name="OR Gate"/>
    <tool lib="2" name="XOR Gate"/>
  </toolbar>
  <circuit name="main"/>
</project>
