<project source="logisim-evolution">
  <lib desc="#Base" name="0"/>
  <lib desc="#Wiring" name="1"/>
  <main name="main"/>
  <toolbar>
    <tool lib="0" name="Poke Tool"/>
  </toolbar>
  <circuit name="main">
    <comp lib="1" loc="(150,100)" name="Tunnel">
      <a name="label" val="N1"/>
    </comp>
    <wire from="(120,100)" to="(180,100)"/>
    <wire from="(150,100)" to="(230,100)"/>
  </circuit>
</project>
