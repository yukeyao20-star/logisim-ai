# Local runtimes and caches
.gradle/
.gradle-local/
.jdks/
build/

# LSP language-server runtimes (installed by lsp\setup-lsp.ps1); tracked
# launcher scripts live in lsp/.
.tools/

# Agent/tool state
.agents/
.codex/
temp/

# Docs stay local-only (shipped inside the release zip)
docs/

# Editor/FUSE temporary files
**/.fuse_hidden*
**/XX*

# IDE/workspace metadata
.classpath
.project
.settings/
bin/

# Third-party checkout is kept outside this recovery repository.
# Intentional Logisim source changes are preserved as patch files under patches/.
third_party/

# Generated binaries and reports
*.class
*.jar
*.log

# Keep generated Logisim examples small and useful for recovery.
!generated/
!generated/circ/
!generated/circ/*.circ
dist/
